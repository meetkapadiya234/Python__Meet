# Generator function that generates the first 10 even numbers. 

def even_numbers():
    for i in range(10):
        yield i * 2

for num in even_numbers():
    print(num)

#  Python program that uses a custom iterator to iterate over a list of integers. 

class MyIter:
    def __init__(self, nums):
        self.nums = nums
        self.i = 0

    def __iter__(self):
        return self

    def __next__(self):
        if self.i < len(self.nums):
            val = self.nums[self.i]
            self.i += 1
            return val
        else:
            raise StopIteration

numbers = [1, 2, 3, 4]

for n in MyIter(numbers):
    print(n)
