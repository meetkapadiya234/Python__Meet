#  Python program to skip 'banana' in a list using the continue 
# statement. List1 = ['apple', 'banana', 'mango'] 

List1 = ['apple', 'banana', 'mango']

for fruit in List1:
    if fruit == 'banana':
        continue
    print(fruit)

#  Python program to stop the loop once 'banana' is found using 
# the break statement.

List1 = ['apple', 'banana', 'mango']

for fruit in List1:
    if fruit == 'banana':
        break
    print(fruit)

